<import src="components/shell.axl" as="Shell" />
<import src="components/tabs.axl" as="Tabs" />
<component name="ModsTrial" />
<template>
  <Shell a-model="destination" :controller="controllerStatus"><panel class="page"><label class="eyebrow">SPLONKS / MODS</label><label class="title">Mods</label>
    <Tabs a-model="modsTab"><panel class="tab-row"><button class="tab tabs-trigger" value="installed">Installed</button><button class="tab tabs-trigger" value="catalog">Browse catalog</button></panel>
      <panel class="installed" d-if="modsTab == 'installed'"><panel class="master scroll"><label class="section">11 INSTALLED PACKAGES</label><button class="mod selected" @click="modBase"><panel><label>Base Content</label><label class="muted">Core package - required</label></panel><label class="good">ACTIVE</label></button><button class="mod" @click="modCartographer"><panel><label>Cartographer's Desk</label><label class="muted">Tools - 2 dependents</label></panel><label class="good">ACTIVE</label></button><button class="mod" @click="modOldLanterns"><panel><label>Old Lanterns</label><label class="muted">Cosmetics - update available</label></panel><label class="warn">UPDATE</label></button><button class="mod" @click="modUnderground"><panel><label>Underground Rivers</label><label class="muted">Worlds - dependency</label></panel><label class="good">ACTIVE</label></button><button class="mod" @click="modTempleWeather"><panel><label>Temple Weather</label><label class="muted">Required by 2 mods</label></panel><label class="good">ACTIVE</label></button><button class="mod" @click="modPocket"><panel><label>Pocket Expedition</label><label class="muted">Requires Temple Weather</label></panel><label class="good">ACTIVE</label></button></panel><panel class="detail scroll"><label class="eyebrow">INSTALLED PACKAGE</label><label class="heading">{{ selectedMod }}</label><label class="good">{{ modActionStatus }}</label><label class="body">A complete package record with local files, compatibility, dependencies, dependents, and session use.</label><label class="section">DEPENDENCIES</label><panel class="dependency"><label>-> Base Content >= 1.4.0</label><label class="good">INSTALLED</label></panel><panel class="dependency"><label>-> Underground Rivers >= 2.2.0</label><label class="good">INSTALLED</label></panel><label class="section">REQUIRED BY</label><panel class="dependency"><label>up Temple Weather</label><label class="good">ACTIVE</label></panel><panel class="dependency"><label>up Pocket Expedition</label><label class="good">ACTIVE</label></panel><panel class="warning"><label>Cascading uninstall is guarded</label><label class="muted">The full dependent change plan appears before mutation.</label></panel><panel class="actions"><button class="primary" @click="updateMod">Update</button><button class="secondary">Open files</button><button class="danger">Uninstall...</button></panel></panel></panel>
      <panel class="catalog" d-if="modsTab == 'catalog'"><panel class="toolbar"><input class="search" a-model="catalogFilter" /><panel class="compatible"><checkbox class="check" a-model="compatibleOnly" /><label>Compatible only</label></panel><button class="secondary">Refresh</button></panel><panel class="workspace"><panel class="master scroll"><label class="section">20 CATALOG MODS</label><button class="mod selected" @click="modMycelium"><panel><label>Mycelium Below</label><label class="muted">Worlds - Root and Branch - 18.8k downloads</label></panel><label class="good">96% POSITIVE</label></button><button class="mod" @click="modBrassline"><panel><label>Brassline Grapple Kit</label><label class="muted">Mechanics - Clockwork Moss - 31.2k</label></panel><label class="good">97%</label></button><button class="mod" @click="modSkybreak"><panel><label>Skybreak Caverns</label><label class="muted">Worlds - Gale Assembly - 12.4k</label></panel><label class="good">91%</label></button><button class="mod" @click="modAbyssal"><panel><label>Abyssal Tide</label><label class="muted">Worlds - Bathysphere - 17.2k</label></panel><label class="good">93%</label></button><button class="mod" @click="modOldLanterns"><panel><label>Old Lanterns</label><label class="muted">Update available</label></panel><label class="warn">UPDATE</label></button><button class="mod" @click="modPocket"><panel><label>Pocket Expedition</label><label class="muted">2 automatic dependencies</label></panel><label class="good">93%</label></button><button class="mod" @click="modTempleWeather"><panel><label>Temple Weather</label><label class="muted">Required by 2 packages</label></panel><label class="good">95%</label></button><button class="mod incompatible" @click="modMirror" d-if="compatibleOnly == false"><panel><label>Mirror Depths</label><label class="muted">Requires Gubsy Mod API 0.2</label></panel><label class="bad">INCOMPATIBLE</label></button><button class="mod" @click="modClockwork"><panel><label>Clockwork Orchard</label><label class="muted">Worlds - Ironfruit Cooperative</label></panel><label class="good">89%</label></button><button class="mod" @click="modLantern"><panel><label>Lantern Cartography</label><label class="muted">Utilities - map annotations</label></panel><label class="good">98%</label></button><button class="mod" @click="modQuietCamps"><panel><label>Quiet Camps</label><label class="muted">Audio - camp ambience</label></panel><label class="good">92%</label></button><button class="mod" @click="modRelic"><panel><label>Relic Ledger</label><label class="muted">Interface - collection tracking</label></panel><label class="good">94%</label></button></panel><panel class="detail scroll"><panel class="art"><label>NO IMAGE PRIMITIVE</label></panel><label class="eyebrow">CATALOG ENTRY</label><label class="heading">{{ selectedMod }}</label><label class="good">{{ modActionStatus }}</label><label class="body">A substantial content package with carefully integrated rooms, mechanics, artwork, and native co-op synchronization.</label><label class="section">COMPATIBILITY and DEPENDENCIES</label><panel class="dependency"><label>-> Base Content >= 1.4.0</label><label class="good">INSTALLED</label></panel><panel class="dependency"><label>-> Underground Rivers >= 2.2.0</label><label class="good">WILL INSTALL</label></panel><label class="section">REQUIRED BY</label><panel class="dependency"><label>up Temple Weather</label><label class="good">ACTIVE</label></panel><panel class="actions"><button class="primary" @click="installSession">Install and add to session</button><button class="secondary" @click="installOnly">Install only</button></panel></panel></panel></panel>
    </Tabs>
  </panel></Shell>
</template>
<style>
.page { width: 100%; height: 100%; gap: 5px; }.eyebrow,.section { color: #9cf47d; font-size: 10px; line-height: 14px; }.title { font-size: 40px; line-height: 46px; }.heading { font-size: 22px; line-height: 28px; }.body { color: #9aabad; font-size: 11px; line-height: 17px; }.muted { color: #8ea0a2; font-size: 9px; line-height: 13px; }.installed,.catalog,.workspace { width: 100%; flex-grow: 1; flex-direction: row; gap: 12px; overflow: hidden; }.catalog { flex-direction: column; }.toolbar { width: 100%; height: 42px; flex-direction: row; gap: 10px; }.search { flex-grow: 1; height: 38px; padding: 9px 12px; background-color: #030b0d; color: #dbe5e4; border-color: #385158; border-width: 1px; }.compatible { width: 190px; padding: 8px; flex-direction: row; gap: 8px; border-color: #294047; border-width: 1px; }.check { width: 20px; height: 20px; color: #9cf47d; border-color: #385158; border-width: 1px; }.master,.detail { height: 100%; padding: 14px; gap: 7px; background-color: #07171a; border-color: #294047; border-width: 1px; }.master { width: 52%; }.detail { width: 46%; }.scroll { overflow: auto; }.mod { width: 100%; height: 56px; padding: 9px 12px; flex-direction: row; align-items: center; justify-content: space-between; background-color: #08191c; color: #dbe5e4; border-color: #294047; border-width: 1px; }.mod:focus,.selected { background-color: #173025; border-color: #9cf47d; }.incompatible { background-color: #211315; }.good { color: #9cf47d; }.warn { color: #f1c75b; }.bad { color: #ff7373; }.dependency { width: 100%; height: 45px; padding: 9px; flex-direction: row; justify-content: space-between; border-color: #294047; border-width: 1px; }.warning { width: 100%; padding: 12px; gap: 3px; background-color: #271a12; border-color: #a66636; border-width: 1px; color: #f0c69b; }.actions { width: 100%; height: 42px; flex-direction: row; gap: 8px; }.primary,.secondary,.danger { padding: 10px 14px; border-width: 1px; }.primary { background-color: #9cf47d; color: #07100d; border-color: #b5ff9b; }.secondary { background-color: #11252a; color: #c7d3d2; border-color: #385158; }.danger { background-color: #211315; color: #ff7373; border-color: #88464b; }.art { width: 100%; height: 105px; align-items: center; justify-content: center; background-color: #12252b; color: #6e8589; border-color: #385158; border-width: 1px; }
</style>
