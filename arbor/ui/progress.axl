<import src="components/shell.axl" as="Shell" />
<import src="components/tabs.axl" as="Tabs" />
<component name="ProgressTrial" />
<template>
  <Shell a-model="destination" :controller="controllerStatus"><panel class="page"><label class="eyebrow">SPLONKS / PROGRESS</label><label class="title">Progress</label><panel class="page-head"><panel><label class="eyebrow">GAME-PROVIDED PROGRESSION</label><label class="muted">3 campaigns - automatic checkpoints</label></panel><button class="primary">+ Choose a new quest</button></panel><panel class="workspace"><panel class="master"><label class="section">CAMPAIGNS</label><button class="campaign selected" @click="campaignGlass"><panel class="art"><label>GC</label></panel><panel><label class="heading">The Glass Caverns</label><label class="muted">Moss - Temple Depths - 42%</label></panel><label class="good">READY</label></button><button class="campaign" @click="campaignQuiet"><panel class="art"><label>QB</label></panel><panel><label class="heading">A Quiet Beginning</label><label class="muted">Vega - Green Valley - 11%</label></panel><label class="good">READY</label></button><button class="campaign" @click="campaignOld"><panel class="art"><label>OE</label></panel><panel><label class="heading">Old Expedition</label><label class="muted">Moss - Version 0.7 data</label></panel><label class="warn">INCOMPATIBLE</label></button></panel><panel class="detail scroll"><panel class="profile"><panel class="avatar"><label>MO</label></panel><panel><label>ASSOCIATED PROFILE</label><label class="muted">Moss - ownership recorded by progression provider</label></panel></panel><label class="eyebrow">RECORDED MOD SET - 7 PACKAGES</label><panel class="package"><label>Base Content</label><label class="cyan">v1.4.0</label></panel><panel class="package"><label>Cartographer's Desk</label><label class="cyan">v0.8.2</label></panel><panel class="package"><label>Old Lanterns</label><label class="warn">Update available</label></panel><button class="secondary">Inspect exact package set</button><label class="eyebrow">CHECKPOINT HISTORY - {{ selectedCampaign }}</label><panel class="checkpoint"><panel><label>Temple safe room</label><label class="muted">Today, 06:52 - Stage 4</label></panel><label class="good">RESUME POINT</label></panel><panel class="checkpoint"><panel><label>Flooded archive</label><label class="muted">Yesterday - Stage 3</label></panel><label class="good">BACKUP</label></panel><panel class="checkpoint"><panel><label>Mushroom crossing</label><label class="muted">Aug 24 - Stage 2</label></panel><label class="good">BACKUP</label></panel><panel class="actions"><button class="primary">> Resume campaign</button><button class="secondary">Export</button><button class="danger">Delete</button></panel></panel></panel></panel></Shell>
</template>
<style>
.page { width: 100%; height: 100%; gap: 5px; }.eyebrow,.section { color: #9cf47d; font-size: 10px; line-height: 14px; }.title { font-size: 40px; line-height: 46px; }.heading { font-size: 16px; line-height: 21px; }.muted { color: #8ea0a2; font-size: 10px; line-height: 14px; }.page-head { width: 100%; height: 48px; flex-direction: row; justify-content: space-between; }.workspace { width: 100%; flex-grow: 1; flex-direction: row; gap: 12px; overflow: hidden; }.master,.detail { height: 100%; padding: 14px; gap: 8px; background-color: #07171a; border-color: #294047; border-width: 1px; }.master { width: 50%; }.detail { width: 48%; }.scroll { overflow: auto; }.campaign { width: 100%; height: 74px; padding: 10px; flex-direction: row; align-items: center; gap: 12px; background-color: #08191c; color: #dbe5e4; border-color: #294047; border-width: 1px; }.campaign > panel { flex-grow: 1; }.campaign:focus,.selected { background-color: #173025; border-color: #9cf47d; }.art,.avatar { width: 44px; height: 44px; align-items: center; justify-content: center; background-color: #3e415d; color: #9cf47d; }.good { color: #9cf47d; }.warn { color: #f1c75b; }.cyan { color: #63d9e6; }.profile { width: 100%; height: 62px; padding: 8px; flex-direction: row; gap: 10px; border-color: #355b46; border-width: 1px; }.package,.checkpoint { width: 100%; height: 42px; padding: 8px; flex-direction: row; justify-content: space-between; border-color: #294047; border-width: 1px; }.actions { width: 100%; height: 42px; flex-direction: row; gap: 8px; }.primary,.secondary,.danger { padding: 10px 14px; border-width: 1px; }.primary { background-color: #9cf47d; color: #07100d; border-color: #b5ff9b; }.secondary { background-color: #11252a; color: #c7d3d2; border-color: #385158; }.danger { background-color: #211315; color: #ff7373; border-color: #88464b; }
</style>
