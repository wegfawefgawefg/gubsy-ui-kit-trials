<import src="components/shell.axl" as="Shell" />
<import src="components/tabs.axl" as="Tabs" />
<component name="ControlsTrial" />
<template>
  <Shell a-model="destination" :controller="controllerStatus">
    <panel class="page"><label class="eyebrow">SPLONKS / CONTROLS</label><label class="title">Controls</label>
      <Tabs a-model="controlsTab">
        <panel class="tab-row"><button class="tab tabs-trigger" value="bindings">Bindings</button><button class="tab tabs-trigger" value="devices">Devices</button><button class="tab tabs-trigger" value="tuning">Input tuning</button></panel>
        <panel class="toolbar" d-if="controlsTab == 'bindings'"><input class="search" value="Filter actions..." /><select class="profile-select" value="Default Binds"><label>Default Binds</label><label>Keyboard Only</label><label>Controller</label></select><button class="secondary">+ New</button><button class="secondary">Rename</button><button class="secondary">Reset</button></panel>
        <panel class="workspace" d-if="controlsTab == 'bindings'">
          <panel class="master scroll"><button class="record selected" @click="bindMenuUp"><label>Menu Up</label><label class="good">D-Pad Up</label></button><button class="record" @click="bindMenuDown"><label>Menu Down</label><label class="good">D-Pad Down</label></button><button class="record" @click="bindMenuLeft"><label>Menu Left</label><label class="good">D-Pad Left</label></button><button class="record" @click="bindMenuRight"><label>Menu Right</label><label class="good">D-Pad Right</label></button><button class="record" @click="bindActivate"><label>Activate</label><label class="good">Gamepad A</label></button><button class="record" @click="bindCancel"><label>Cancel</label><label class="good">Gamepad B</label></button><button class="record" @click="bindMove"><label>Move</label><label class="good">Left Stick</label></button><button class="record" @click="bindLook"><label>Look</label><label class="good">Right Stick</label></button><button class="record" @click="bindFire"><label>Fire</label><label class="good">Right Trigger</label></button></panel>
          <panel class="detail"><label class="eyebrow">SELECTED ACTION</label><label class="heading">{{ selectedAction }}</label><label class="body">An action can own multiple digital, one-dimensional, or two-dimensional bindings.</label><panel class="binding"><label>1   D-Pad Up</label><button class="link">Replace</button></panel><panel class="binding"><label>2   Keyboard W</label><button class="link">Replace</button></panel><panel class="binding"><label>3   Keyboard up</label><button class="link">Replace</button></panel><panel class="actions"><button class="primary" @click="captureBinding">{{ captureBinding }} Listen for input</button><button class="secondary">Browse controls</button></panel><label class="note">Manual browsing is required for trigger-to-button mappings, unusual wheels, pedals, joysticks, and macro pads.</label></panel>
        </panel>
        <panel class="workspace" d-if="controlsTab == 'devices'"><panel class="master"><label class="eyebrow">LOCAL PLAYERS</label><button class="player selected"><label>Moss</label><label class="muted">Ready - 2 assigned devices</label></button><button class="player"><label>Open slot</label><label class="muted">No devices</label></button><button class="secondary">Assign device</button></panel><panel class="detail"><label class="eyebrow">DEVICE OWNERSHIP</label><label class="heading">Moss</label><panel class="binding"><label>Xbox Wireless Controller</label><label class="good">PRIMARY</label></panel><panel class="binding"><label>Keyboard + Mouse</label><label class="good">SHARED</label></panel><label class="section">AVAILABLE</label><panel class="binding"><label>Driving Force Wheel</label><button class="link">Assign</button></panel><panel class="binding"><label>Macro Pad</label><button class="link">Assign</button></panel><label class="note">One player may own several devices. A device inspector exposes every raw Gubsy input name and live value.</label></panel></panel>
        <panel class="workspace" d-if="controlsTab == 'tuning'"><panel class="master scroll"><label class="eyebrow">INPUT PROFILE - XBOX WIRELESS CONTROLLER</label><panel class="slider-row"><panel class="row-head"><label>Look sensitivity</label><label class="good">{{ lookSensitivity }}%</label></panel><slider class="slider" a-model="lookSensitivity" :min="1" :max="100" :step="1" /></panel><panel class="slider-row"><panel class="row-head"><label>Stick deadzone</label><label class="good">{{ stickDeadzone }}%</label></panel><slider class="slider" a-model="stickDeadzone" :min="0" :max="40" :step="1" /></panel><panel class="slider-row"><panel class="row-head"><label>Vibration strength</label><label class="good">{{ vibration }}%</label></panel><slider class="slider" a-model="vibration" :min="0" :max="100" :step="1" /></panel><panel class="row"><panel><label>Response curve</label><label class="muted">Stick magnitude transformation</label></panel><select class="profile-select" a-model="responseCurve"><label>Smooth</label><label>Linear</label><label>Aggressive</label></select></panel></panel><panel class="detail"><label class="eyebrow">DEVICE RESPONSE</label><label class="heading">Live response</label><panel class="stick"><panel class="dot" /></panel><panel class="context"><label>Device</label><label class="cyan">Xbox Wireless Controller</label><label>Deadzone</label><label class="cyan">{{ stickDeadzone }}%</label><label>Curve</label><label class="cyan">{{ responseCurve }}</label></panel></panel></panel>
      </Tabs>
    </panel>
  </Shell>
</template>
<style>
.page { width: 100%; height: 100%; gap: 5px; }.eyebrow,.section { color: #9cf47d; font-size: 10px; line-height: 14px; }.title { font-size: 40px; line-height: 46px; }.heading { font-size: 24px; line-height: 30px; }.body,.note { color: #9aabad; font-size: 11px; line-height: 17px; }.muted { color: #8ea0a2; font-size: 10px; line-height: 14px; }.toolbar { width: 100%; height: 42px; flex-direction: row; gap: 8px; }.search { width: 42%; height: 38px; padding: 9px 12px; background-color: #030b0d; color: #8ea0a2; border-color: #385158; border-width: 1px; }.profile-select { width: 190px; height: 38px; padding: 9px 12px; background-color: #030b0d; color: #e1e9e8; border-color: #385158; border-width: 1px; }.profile-select > popup { background-color: #0d2024; border-color: #63d9e6; border-width: 1px; }.workspace { width: 100%; flex-grow: 1; flex-direction: row; gap: 12px; overflow: hidden; }.master,.detail { height: 100%; padding: 14px; gap: 9px; background-color: #07171a; border-color: #294047; border-width: 1px; }.master { width: 46%; }.detail { width: 52%; }.scroll { overflow: auto; }.record,.binding,.player,.row { width: 100%; height: 54px; padding: 10px 12px; flex-direction: row; align-items: center; justify-content: space-between; background-color: #08191c; color: #dbe5e4; border-color: #294047; border-width: 1px; }.record:focus,.player:focus,.selected { background-color: #173025; border-color: #9cf47d; }.good,.link { color: #9cf47d; }.link { background-color: #08191c; }.actions { width: 100%; height: 42px; flex-direction: row; gap: 8px; }.primary,.secondary { padding: 10px 14px; border-width: 1px; }.primary { background-color: #9cf47d; color: #07100d; border-color: #b5ff9b; }.secondary { background-color: #11252a; color: #c7d3d2; border-color: #385158; }.slider-row { width: 100%; height: 76px; padding: 12px; border-color: #294047; border-width: 1px; }.row-head { width: 100%; flex-direction: row; justify-content: space-between; }.slider { width: 100%; height: 18px; margin: 9px 0px 0px 0px; background-color: #12282d; color: #9cf47d; }.slider > track { background-color: #193238; }.slider > thumb { background-color: #9cf47d; border-radius: 9px; }.stick { width: 190px; height: 190px; margin: 18px; align-items: center; justify-content: center; border-color: #385158; border-width: 1px; border-radius: 95px; }.dot { width: 28px; height: 28px; border-radius: 14px; background-color: #9cf47d; }.context { width: 100%; padding: 12px; flex-direction: row; justify-content: space-between; color: #8ea0a2; }.cyan { color: #63d9e6; }
</style>
