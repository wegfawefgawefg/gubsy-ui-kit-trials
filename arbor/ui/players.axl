<import src="components/shell.axl" as="Shell" />
<import src="components/tabs.axl" as="Tabs" />
<component name="PlayersTrial" />
<template>
  <Shell a-model="destination" :controller="controllerStatus">
    <panel class="page"><label class="eyebrow">SPLONKS / PLAYERS</label><label class="title">Players</label>
      <Tabs a-model="playersTab">
        <panel class="tab-row"><button class="tab tabs-trigger" value="local">Local players</button><button class="tab tabs-trigger" value="profiles">Profiles</button><button class="tab tabs-trigger" value="devices">Devices</button></panel>
        <panel class="workspace" d-if="playersTab == 'local'">
          <panel class="master"><label class="eyebrow">LOCAL PARTY</label><label class="heading">Players and devices</label><button class="record selected"><label>P1  Moss</label><label class="muted">Ready - Xbox Wireless Controller + Keyboard</label></button><button class="record"><label>P2  Open slot</label><label class="muted">Press a button or assign a device</label></button><button class="record"><label>P3  Open slot</label><label class="muted">Available</label></button></panel>
          <panel class="detail"><label class="eyebrow">SELECTED PLAYER</label><label class="heading">Moss</label><panel class="summary"><label>PROFILE</label><label>Moss</label><label>STATUS</label><label>Ready</label></panel><label class="section">ASSIGNED DEVICES</label><panel class="device"><label>Xbox Wireless Controller</label><label class="good">PRIMARY</label></panel><panel class="device"><label>Keyboard + Mouse</label><label class="good">SHARED</label></panel><panel class="actions"><button class="secondary">Assign device</button><button class="primary" @click="toggleReady">Toggle ready</button></panel></panel>
        </panel>
        <panel class="profile-view" d-if="playersTab == 'profiles'"><panel class="profile-head"><panel><label class="eyebrow">PROFILE LIBRARY</label><label class="muted">Profile data is not a save</label></panel><button class="primary">+ New profile</button></panel><panel class="profile-grid"><button class="profile-card" @click="profileMoss"><label class="avatar">MO</label><label class="heading">Moss</label><label class="muted">38h 22m - 84 runs - 21 wins</label></button><button class="profile-card" @click="profileVega"><label class="avatar">VE</label><label class="heading">Vega</label><label class="muted">14h 11m - 31 runs - 4 wins</label></button><button class="profile-card" @click="profileGuest"><label class="avatar">GU</label><label class="heading">Guest</label><label class="muted">Never - 0 runs - 0 wins</label></button></panel><label class="heading">{{ selectedProfile }}'s history</label><panel class="stats"><label>84 PLAYS</label><label>21 WINS</label><label>138 DEATHS</label><label>2.4M SCORE</label><label>42 REPLAYS</label></panel></panel>
        <panel class="workspace" d-if="playersTab == 'devices'"><panel class="master"><label class="eyebrow">RECOGNIZED DEVICES</label><button class="record selected"><label>Xbox Wireless Controller</label><label class="muted">Assigned to Moss - active now</label></button><button class="record"><label>Keyboard + Mouse</label><label class="muted">Assigned to Moss - shared capable</label></button><button class="record"><label>Driving Force Wheel</label><label class="muted">Unassigned - 18 inputs</label></button><button class="record"><label>Macro Pad</label><label class="muted">Unassigned - 12 inputs</label></button></panel><panel class="detail"><label class="eyebrow">DEVICE INSPECTOR</label><label class="heading">Xbox Wireless Controller</label><label class="muted">Press controls to inspect raw Gubsy input names.</label><panel class="input-grid"><label>A</label><label class="good">Button South</label><label>LT</label><label>Trigger Left - 0.00</label><label>L Stick</label><label>Axis 0 / 1 - 0.00, 0.00</label></panel><panel class="actions"><button class="secondary">Identify</button><button class="primary">Assign to player</button></panel></panel></panel>
      </Tabs>
    </panel>
  </Shell>
</template>
<style>
.page { width: 100%; height: 100%; gap: 5px; }.eyebrow,.section { color: #9cf47d; font-size: 10px; line-height: 14px; }.title { font-size: 40px; line-height: 46px; }.heading { font-size: 20px; line-height: 26px; }.muted { color: #8ea0a2; font-size: 10px; line-height: 14px; }.workspace { width: 100%; flex-grow: 1; flex-direction: row; gap: 12px; overflow: hidden; }.master,.detail,.profile-view { height: 100%; padding: 16px; gap: 10px; background-color: #07171a; border-color: #294047; border-width: 1px; }.master { width: 48%; }.detail { flex-grow: 1; }.record { width: 100%; height: 62px; padding: 10px 12px; gap: 2px; background-color: #0a1c20; color: #dbe5e4; border-color: #294047; border-width: 1px; }.record:focus,.selected { background-color: #173025; border-color: #9cf47d; }.summary,.input-grid { width: 100%; padding: 12px; flex-direction: row; justify-content: space-between; gap: 12px; border-color: #294047; border-width: 1px; color: #9aacaf; }.device { width: 100%; height: 50px; padding: 12px; flex-direction: row; justify-content: space-between; border-color: #294047; border-width: 1px; }.good { color: #9cf47d; }.actions { width: 100%; height: 42px; flex-direction: row; gap: 8px; }.actions > button { flex-grow: 1; }.primary,.secondary { padding: 10px 14px; border-width: 1px; }.primary { background-color: #9cf47d; color: #07100d; border-color: #b5ff9b; }.secondary { background-color: #11252a; color: #c7d3d2; border-color: #385158; }.profile-view { width: 100%; flex-grow: 1; }.profile-head { width: 100%; height: 44px; flex-direction: row; justify-content: space-between; }.profile-grid { width: 100%; height: 145px; flex-direction: row; gap: 10px; }.profile-card { flex-grow: 1; padding: 14px; align-items: center; gap: 5px; color: #dbe5e4; background-color: #091a1e; border-color: #294047; border-width: 1px; }.profile-card:focus { border-color: #63d9e6; background-color: #173025; }.avatar { padding: 10px; border-color: #5b8b66; border-width: 1px; color: #9cf47d; }.stats { width: 100%; height: 90px; flex-direction: row; justify-content: space-between; align-items: center; color: #9cf47d; font-size: 16px; line-height: 22px; }
</style>
