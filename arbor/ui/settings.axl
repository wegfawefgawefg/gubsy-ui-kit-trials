<import src="components/shell.axl" as="Shell" />
<import src="components/tabs.axl" as="Tabs" />
<component name="SettingsTrial" />
<template>
  <Shell a-model="destination" :controller="controllerStatus">
    <panel class="page"><label class="eyebrow">SPLONKS / SETTINGS</label><label class="title">Settings</label>
      <Tabs a-model="settingsTab">
        <panel class="tab-row"><button class="tab tabs-trigger" value="display">Display</button><button class="tab tabs-trigger" value="audio">Audio</button><button class="tab tabs-trigger" value="accessibility">Accessibility</button><button class="tab tabs-trigger" value="gameplay">Gameplay</button></panel>
        <panel class="workspace">
          <panel class="settings-list">
            <panel d-if="settingsTab == 'display'" class="scroll-list"><label class="section">DISPLAY - 6 OPTIONS</label><panel class="row"><panel><label>Fullscreen</label><label class="muted">Use the entire selected display</label></panel><checkbox class="toggle" a-model="fullscreen" /></panel><panel class="row"><panel><label>Display resolution</label><label class="muted">Output resolution for this display</label></panel><select class="select" a-model="resolution"><label>1280 x 720</label><label>1920 x 1080</label><label>2560 x 1440</label><label>3840 x 2160</label></select></panel><panel class="slider-row"><panel class="row-head"><label>Render scale</label><label class="good">{{ renderScale }}%</label></panel><slider class="slider" a-model="renderScale" :min="50" :max="150" :step="1" /></panel><panel class="row"><panel><label>Frame cap</label><label class="muted">Maximum simulation frames per second</label></panel><select class="select" a-model="frameCap"><label>60 FPS</label><label>120 FPS</label><label>144 FPS</label><label>Unlimited</label></select></panel><panel class="slider-row"><panel class="row-head"><label>Brightness</label><label class="good">{{ brightness }}%</label></panel><slider class="slider" a-model="brightness" :min="0" :max="100" :step="1" /></panel><panel class="row"><panel><label>Vertical synchronization</label><label class="muted">Synchronize presentation to display</label></panel><checkbox class="toggle" a-model="vsync" /></panel></panel>
            <panel d-if="settingsTab == 'audio'" class="scroll-list"><label class="section">AUDIO MIX</label><panel class="slider-row"><panel class="row-head"><label>Master volume</label><label class="good">{{ masterVolume }}%</label></panel><slider class="slider" a-model="masterVolume" :min="0" :max="100" :step="1" /></panel><panel class="slider-row"><panel class="row-head"><label>Music</label><label class="good">60%</label></panel><slider class="slider" :value="60" :min="0" :max="100" :step="1" /></panel><panel class="slider-row"><panel class="row-head"><label>Effects</label><label class="good">75%</label></panel><slider class="slider" :value="75" :min="0" :max="100" :step="1" /></panel><panel class="row"><panel><label>Dynamic range</label><label class="muted">Output compression profile</label></panel><select class="select" value="Full"><label>Full</label><label>Night</label><label>Headphones</label></select></panel></panel>
            <panel d-if="settingsTab == 'accessibility'" class="scroll-list"><label class="section">ACCESSIBILITY</label><panel class="row"><panel><label>Subtitles</label><label class="muted">Dialogue and authored narration</label></panel><checkbox class="toggle" a-model="subtitles" /></panel><panel class="row"><panel><label>Subtitle size</label><label class="muted">Scale independently from interface text</label></panel><select class="select" value="Large"><label>Normal</label><label>Large</label><label>Extra large</label></select></panel><panel class="row"><panel><label>Color vision filter</label><label class="muted">Gameplay color transformation</label></panel><select class="select" value="Off"><label>Off</label><label>Deuteranopia</label><label>Protanopia</label><label>Tritanopia</label></select></panel><button class="row">Configure input assists</button></panel>
            <panel d-if="settingsTab == 'gameplay'" class="scroll-list"><label class="section">GAMEPLAY</label><panel class="row"><panel><label>Camera shake</label><label class="muted">Strength of authored camera impulses</label></panel><select class="select" value="Reduced"><label>Full</label><label>Reduced</label><label>Off</label></select></panel><panel class="row"><panel><label>Auto-pause on disconnect</label><label class="muted">Pause when a local device disappears</label></panel><checkbox class="toggle" checked="true" /></panel><panel class="row"><panel><label>Online invitations</label><label class="muted">Who may send session invitations</label></panel><select class="select" value="Friends"><label>Friends</label><label>Anyone</label><label>Disabled</label></select></panel></panel>
          </panel>
          <panel class="detail"><label class="eyebrow">SELECTED SETTING</label><label class="heading">Native Arbor controls</label><label class="body">These values are bound through Arbor's typed model writer and commit in the same application-loop frame.</label><panel class="value-card"><label class="section">CURRENT PROFILE</label><label class="value">Vega - saved locally</label></panel><panel class="context"><label>Scope</label><label class="cyan">Current machine</label><label>Applies</label><label class="cyan">Immediately</label><label>Restart</label><label class="cyan">Not required</label></panel><panel class="actions"><button class="primary">Apply settings</button><button class="secondary">Reset category</button></panel></panel>
        </panel>
      </Tabs>
    </panel>
  </Shell>
</template>
<style>
.page { width: 100%; height: 100%; gap: 5px; }.eyebrow,.section { color: #9cf47d; font-size: 10px; line-height: 14px; }.title { font-size: 40px; line-height: 46px; }.heading { font-size: 22px; line-height: 28px; }.body { color: #9aabad; font-size: 12px; line-height: 18px; }.workspace { width: 100%; flex-grow: 1; flex-direction: row; gap: 12px; overflow: hidden; }.settings-list { width: 53%; height: 100%; background-color: #07171a; border-color: #294047; border-width: 1px; overflow: hidden; }.scroll-list { width: 100%; height: 100%; padding: 12px 16px; gap: 0px; overflow: auto; }.row,.slider-row { width: 100%; height: 68px; padding: 10px 12px; border-color: #294047; border-width: 1px; background-color: #08191c; color: #dbe5e4; }.row { flex-direction: row; align-items: center; justify-content: space-between; }.row:focus { background-color: #173025; border-color: #63d9e6; }.muted { color: #8ea0a2; font-size: 10px; line-height: 14px; }.row-head { width: 100%; flex-direction: row; justify-content: space-between; }.good { color: #9cf47d; }.select { width: 220px; height: 38px; padding: 9px 12px; background-color: #030b0d; color: #e1e9e8; border-color: #385158; border-width: 1px; }.select:focus,.toggle:focus { border-color: #63d9e6; }.select > popup { background-color: #0d2024; border-color: #63d9e6; border-width: 1px; }.toggle { width: 48px; height: 26px; background-color: #102328; color: #9cf47d; border-color: #385158; border-width: 1px; }.toggle:checked { background-color: #4e8b4b; }.toggle > mark { background-color: #e8ffdf; }.slider { width: 100%; height: 18px; margin: 8px 0px 0px 0px; background-color: #12282d; color: #9cf47d; }.slider > track { background-color: #193238; }.slider > thumb { background-color: #9cf47d; border-radius: 9px; }.detail { width: 45%; height: 100%; overflow: hidden; padding: 18px; gap: 14px; background-color: #07171a; border-color: #294047; border-width: 1px; }.value-card,.context { width: 100%; padding: 14px; gap: 8px; border-color: #355b46; border-width: 1px; background-color: #10241d; }.value { color: #9cf47d; font-size: 20px; line-height: 28px; }.context { color: #8ea0a2; }.cyan { color: #63d9e6; }.actions { width: 100%; height: 42px; flex-direction: row; gap: 8px; }.primary,.secondary { flex-grow: 1; padding: 10px 14px; border-width: 1px; }.primary { background-color: #9cf47d; color: #07100d; border-color: #b5ff9b; }.secondary { background-color: #11252a; color: #c7d3d2; border-color: #385158; }
</style>
